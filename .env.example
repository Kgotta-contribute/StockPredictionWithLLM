# Polygon.io API Key (Get a free key from https://polygon.io)
POLYGON_API_KEY=your_polygon_api_key_here

# Hugging Face Access Token (Get a free token from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Local Port (Default: 3000)
PORT=3000

# Optional: Custom Hugging Face Model & Provider overrides
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
# HUGGINGFACE_PROVIDER=auto
